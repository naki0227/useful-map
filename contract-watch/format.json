{
  "$comment": [
    "Google Maps 内部 URL（data=）の構造定義。アプリ側 GoogleMapsURLBuilder と契約監視の共有真実。",
    "Swift 側の生成結果がこの定義と一致することは DataTests/URLFormatContractTests が検証する。",
    "形式が壊れた場合、CI の自動修復はこのファイルの最小差分を探索して更新する。",
    "地点ブロックに Place ID を入れると Google が解決に失敗して地点が見つからなくなるため、",
    "座標だけを渡す（実機の Safari で検証済み: 2026-08-15）。"
  ],
  "version": 1,
  "host": "https://www.google.com",
  "pathPrefix": "/maps/dir/",
  "dataPrefix": "/data=",
  "wrapper": {
    "outer": {
      "group": 4,
      "kind": "m",
      "value": "{outerCount}"
    },
    "inner": {
      "group": 4,
      "kind": "m",
      "value": "{innerCount}"
    }
  },
  "placeBlock": [
    {
      "group": 1,
      "kind": "m",
      "value": "3"
    },
    {
      "group": 2,
      "kind": "m",
      "value": "2"
    },
    {
      "group": 1,
      "kind": "d",
      "value": "{longitude}"
    },
    {
      "group": 2,
      "kind": "d",
      "value": "{latitude}"
    }
  ],
  "timeBlock": [
    {
      "group": 2,
      "kind": "m",
      "value": "3"
    },
    {
      "group": 6,
      "kind": "e",
      "value": "{timeMode}"
    },
    {
      "group": 7,
      "kind": "e",
      "value": "2"
    },
    {
      "group": 8,
      "kind": "j",
      "value": "{timestamp}"
    }
  ],
  "modeToken": {
    "group": 3,
    "kind": "e",
    "value": "{modeCode}"
  },
  "timeMode": {
    "departAt": "0",
    "arriveBy": "1"
  },
  "modeCode": {
    "driving": "0",
    "walking": "2",
    "transit": "3"
  },
  "coordinatePrecision": 7,
  "modeCodeReference": {
    "driving": "0",
    "bicycling": "1",
    "walking": "2",
    "transit": "3",
    "flight": "4"
  }
}
